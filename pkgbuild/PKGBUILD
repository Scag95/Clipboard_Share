# Maintainer: Nudge contributors
pkgname=nudge
pkgver=0.1.0
pkgrel=2
pkgdesc='Share the clipboard and remote input between phones and a Linux desktop'
arch=('x86_64')
license=('MIT')
depends=('wl-clipboard' 'qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg')
makedepends=('go')
options=('!lto')
source=()

_repo="$startdir/.."

prepare() {
  rm -rf "$srcdir/$pkgname"
  mkdir -p "$srcdir/$pkgname/pkgbuild"
  # Copy only the sources needed to build; never build inside the repo tree.
  tar -C "$_repo" --exclude='panel/build' -cf - go.mod go.sum cmd internal panel \
    | tar -C "$srcdir/$pkgname" -xf -
  # The panel resources reference ../../pkgbuild/nudge.svg, and its tests the
  # packaged autostart entry.
  cp "$_repo/pkgbuild/nudge.svg" "$_repo/pkgbuild/nudge-panel-autostart.desktop" "$srcdir/$pkgname/pkgbuild/"
}

build() {
  cd "$srcdir/$pkgname"
  export CGO_CPPFLAGS="$CPPFLAGS"
  export CGO_CFLAGS="$CFLAGS"
  export CGO_CXXFLAGS="$CXXFLAGS"
  export CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS="-buildmode=pie -trimpath -mod=readonly -modcacherw"
  go build -o nudge ./cmd/server

  sh panel/bin/build
}

package() {
  cd "$srcdir/$pkgname"
  install -Dm755 nudge "$pkgdir/usr/bin/nudge"
  install -Dm755 panel/build/nudge-panel "$pkgdir/usr/bin/nudge-panel"
  install -Dm644 "$startdir/nudge.service" \
    "$pkgdir/usr/lib/systemd/user/nudge.service"
  install -Dm644 "$startdir/99-nudge-uinput.rules" \
    "$pkgdir/usr/lib/udev/rules.d/99-nudge-uinput.rules"
  install -Dm644 "$startdir/nudge.desktop" \
    "$pkgdir/usr/share/applications/nudge.desktop"
  install -Dm644 "$startdir/nudge-panel-autostart.desktop" \
    "$pkgdir/etc/xdg/autostart/nudge-panel.desktop"
  install -Dm644 "$startdir/nudge.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/nudge.svg"
}
