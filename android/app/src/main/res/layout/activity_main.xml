<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1E"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clipboard Share"
        android:textColor="#F5F5F7"
        android:textSize="26sp"
        android:textStyle="bold" />

    <!-- Search state on the left, rescan button on the right -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/scanDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/dot_scan" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:text="Buscando dispositivos en tu red…"
            android:textColor="#A8A8B3"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRescan"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_badge"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingEnd="16dp"
            android:paddingStart="16dp"
            android:text="↻ Buscar de nuevo"
            android:textAllCaps="false"
            android:textColor="#F5F5F7"
            android:textSize="14sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/hostList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_help"
        android:lineSpacingMultiplier="1.2"
        android:padding="14dp"
        android:text="Los dispositivos aparecen solos cuando el PC con Clipboard Share está encendido y en la misma red wifi."
        android:textColor="#A8A8B3"
        android:textSize="13sp" />
</LinearLayout>
