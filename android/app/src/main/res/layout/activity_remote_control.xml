<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: host name and one badge that opens the connection panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/rcDot"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@drawable/dot_status" />

            <TextView
                android:id="@+id/rcHost"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="#F5F5F7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStatusBadge"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge"
                android:ellipsize="end"
                android:maxWidth="190dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingEnd="14dp"
                android:paddingStart="14dp"
                android:singleLine="true"
                android:textAllCaps="false"
                android:textColor="#F5F5F7"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Connection and pairing messages -->
        <TextView
            android:id="@+id/rcStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="6dp"
            android:text="Preparando conexión…"
            android:textColor="#A8A8B3"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Conectar"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnCancelPairing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancelar"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Touchpad with the two click zones integrated in the same frame -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pad_frame"
            android:clipToOutline="true"
            android:orientation="vertical">

            <com.clipboardshare.TouchpadView
                android:id="@+id/touchpad"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="#222228"
                android:minHeight="120dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#45454D" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnClickLeft"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_click_strip"
                    android:contentDescription="Clic izquierdo"
                    android:stateListAnimator="@null" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#45454D" />

                <Button
                    android:id="@+id/btnClickRight"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_click_strip"
                    android:contentDescription="Clic derecho"
                    android:stateListAnimator="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Shortcuts: four frequent ones, the rest in an expandable section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCtrlC"
                    style="@style/RemoteKey"
                    android:text="Ctrl+C" />

                <Button
                    android:id="@+id/btnCtrlV"
                    style="@style/RemoteKey"
                    android:text="Ctrl+V" />

                <Button
                    android:id="@+id/btnCtrlX"
                    style="@style/RemoteKey"
                    android:text="Ctrl+X" />

                <Button
                    android:id="@+id/btnCtrlZ"
                    style="@style/RemoteKey"
                    android:text="Ctrl+Z" />

                <Button
                    android:id="@+id/btnMoreShortcuts"
                    style="@style/RemoteKey"
                    android:layout_width="48dp"
                    android:layout_weight="0"
                    android:contentDescription="Más atajos"
                    android:text="▴" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/moreShortcuts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnEsc"
                            style="@style/RemoteKey"
                            android:text="Esc" />

                        <Button
                            android:id="@+id/btnEnter"
                            style="@style/RemoteKey"
                            android:text="Enter" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnTab"
                            style="@style/RemoteKey"
                            android:text="Tab" />

                        <Button
                            android:id="@+id/btnDelete"
                            style="@style/RemoteKey"
                            android:text="Supr" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal">

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />

                        <Button
                            android:id="@+id/btnArrowUp"
                            style="@style/RemoteKey"
                            android:contentDescription="Arriba"
                            android:text="↑" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnArrowLeft"
                            style="@style/RemoteKey"
                            android:contentDescription="Izquierda"
                            android:text="←" />

                        <Button
                            android:id="@+id/btnArrowDown"
                            style="@style/RemoteKey"
                            android:contentDescription="Abajo"
                            android:text="↓" />

                        <Button
                            android:id="@+id/btnArrowRight"
                            style="@style/RemoteKey"
                            android:contentDescription="Derecha"
                            android:text="→" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- The word being typed, so there is feedback without a text field -->
        <TextView
            android:id="@+id/typedWord"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:ellipsize="start"
            android:gravity="center"
            android:paddingEnd="14dp"
            android:paddingStart="14dp"
            android:singleLine="true"
            android:text="Palabra actual"
            android:textColor="#A8A8B3"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btnKeyboard"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_accent"
            android:text="⌨  Teclado"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.clipboardshare.RemoteKeyboardView
            android:id="@+id/remoteKeyboard"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- Connection panel opened from the header badge -->
    <LinearLayout
        android:id="@+id/connPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginEnd="14dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="62dp"
        android:background="@drawable/bg_panel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Portapapeles"
            android:textColor="#A8A8B3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/clipboardStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Sincronización pendiente"
            android:textColor="#F5F5F7"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/cbShareImages"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:text="Sincronizar imágenes"
            android:textColor="#F5F5F7" />

        <Button
            android:id="@+id/btnDisconnect"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_release"
            android:text="Soltar conexión"
            android:textAllCaps="false"
            android:textColor="#FF9B9B" />
    </LinearLayout>
</FrameLayout>
