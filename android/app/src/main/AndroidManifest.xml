<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.clipboardshare">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed only for MediaStore writes on API < 29 (scoped storage handles 10+). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Beta personal: el server LAN habla http/ws sin TLS (ver PLAN "Seguridad"
         como trabajo futuro para una versión pública). -->
    <application
        android:usesCleartextTraffic="true"
        android:label="Clipboard Share"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".RemoteControlActivity"
            android:exported="false"
            android:label="Control remoto" />
        <activity
            android:name=".ClipboardReadActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Manual phone -> PC send, like KDE Connect (Android 10+ denies clipboard
             reads without focus, so the tile opens ClipboardReadActivity). -->
        <service
            android:name=".ClipboardSendTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_send"
            android:label="Enviar portapapeles"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".ClipboardSyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
