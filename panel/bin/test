#!/bin/sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
# The single-instance tests launch the real panel binary (offscreen, isolated).
"$ROOT/bin/build"
for suite in panel_tests ui_tests; do
    mkdir -p "$ROOT/build/$suite-dir"
    cd "$ROOT/build/$suite-dir"
    qmake6 "$ROOT/tests/$suite.pro"
    make -j"$(nproc)"
    QT_QPA_PLATFORM=offscreen QT_FORCE_STDERR_LOGGING=1 "./$suite"
done
